{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Central de Atendimento Operador",
  "version": "0.1.1",
  "identifier": "br.com.atualrnc.central-atendimento-operador",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Central de Atendimento v0.1.1",
        "url": "index.html",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": "nsis",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Central de Atendimento",
        "installerHooks": "hooks.nsh"
      }
    }
  }
}
