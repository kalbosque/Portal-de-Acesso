{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Central de Atendimento Operador",
  "version": "0.1.9",
  "identifier": "br.com.atualrnc.central-atendimento-operador",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' data: blob: https: http:; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline' https: http:; script-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:* https://* ws: wss:; font-src 'self' data: https: http:; frame-src 'self' https: http:; media-src 'self' https: http:; object-src 'none'; base-uri 'self';"
    },
    "windows": [
      {
        "label": "main",
        "title": "Central de Atendimento v0.1.9",
        "url": "index.html",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": "nsis",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Central de Atendimento",
        "installerHooks": "hooks.nsh"
      }
    }
  }
}
