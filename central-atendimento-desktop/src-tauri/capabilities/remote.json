{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-access",
  "description": "Permite que o servidor web local acione comandos Tauri (notificações, alertas)",
  "windows": ["main"],
  "remote": {
    "urls": ["http://192.168.1.230:3001/**"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-is-focused",
    "core:window:allow-is-minimized",
    "allow-trigger-message-alert",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-request-permission",
    "notification:allow-check-permissions",
    "notification:allow-is-permission-granted",
    "notification:allow-permission-state"
  ]
}
