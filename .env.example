# Configurações do Banco de Dados
POSTGRES_PASSWORD=sua_senha_forte_aqui

# Configurações do Evolution API (WhatsApp)
EVOLUTION_API_KEY=sua_api_key_forte_aqui

# Configurações do Agente
AGENT_API_KEY=sua_api_key_do_agente_aqui

# Token do Cloudflare Tunnel (obtido em Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=cole_o_token_do_cloudflare_aqui

# Multiempresa somente para o Atendimento; manter false durante o piloto
ATENDIMENTO_MULTIEMPRESA_ENABLED=false

# Configurações de Email (Opcional - Worker)
SMTP_SERVER=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=conta-que-envia@seu-dominio.com
SMTP_PASS=sua_credencial_smtp_aqui
SMTP_FROM=conta-que-envia@seu-dominio.com
